{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TeacherEvan/Plastic-Surgery/schemas/video-polish-report.schema.json",
  "title": "PlasticSurgeryVideoPolishReport",
  "type": "object",
  "required": [
    "target",
    "mode",
    "format",
    "safe_mode",
    "metrics",
    "video_health_score",
    "defects_count",
    "defects"
  ],
  "properties": {
    "target": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "storyboard",
        "video"
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "9:16",
        "16:9",
        "1:1",
        "4:5",
        "custom"
      ]
    },
    "safe_mode": {
      "type": "string",
      "enum": [
        "organic",
        "strict"
      ]
    },
    "metrics": {
      "$ref": "#/$defs/Metrics"
    },
    "video_health_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "defects_count": {
      "type": "integer",
      "minimum": 0
    },
    "defects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Defect"
      }
    }
  },
  "$defs": {
    "Metrics": {
      "type": "object",
      "properties": {
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "fps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "avg_fps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "scenes_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_duration_sec": {
          "type": "number",
          "minimum": 0
        },
        "duration_sec": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "style_preset": {
          "type": [
            "string",
            "null"
          ]
        },
        "ink_ground_contrast": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "accent_ground_contrast": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "has_grade": {
          "type": "boolean"
        },
        "threejs_scenes": {
          "type": "integer",
          "minimum": 0
        },
        "external_glb_assets": {
          "type": "integer",
          "minimum": 0
        },
        "video_codec": {
          "type": [
            "string",
            "null"
          ]
        },
        "pix_fmt": {
          "type": [
            "string",
            "null"
          ]
        },
        "color_space": {
          "type": [
            "string",
            "null"
          ]
        },
        "color_primaries": {
          "type": [
            "string",
            "null"
          ]
        },
        "color_transfer": {
          "type": [
            "string",
            "null"
          ]
        },
        "audio_codec": {
          "type": [
            "string",
            "null"
          ]
        },
        "audio_sample_rate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "audio_channels": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "faststart": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "integrated_lufs": {
          "type": [
            "number",
            "null"
          ]
        },
        "true_peak_dbtp": {
          "type": [
            "number",
            "null"
          ]
        },
        "dead_air_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "storyboard_drift_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "video_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "video_level": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sample_aspect_ratio": {
          "type": [
            "string",
            "null"
          ]
        },
        "bitrate_kbps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "file_size_mb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "black_intervals": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "freeze_intervals": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "avg_luma": {
          "type": [
            "number",
            "null"
          ]
        },
        "luma_range": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "avg_saturation": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "unevaluatedProperties": false
    },
    "Defect": {
      "type": "object",
      "required": [
        "file",
        "line",
        "code",
        "severity",
        "message",
        "fix"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "severity": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "fix": {
          "type": "string",
          "minLength": 1
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
